.DS_Store
node_modules/
logs/
*.log

# Maven help:effective-pom output -- a build artifact, regenerate with:
#   mvn -q help:effective-pom -Doutput=effective-pom.xml
# (use -Doutput= or -B, never `> file`, or Maven writes ANSI colour codes into it)
effective-pom.xml

# Holds live credentials. Written by hand on the VM, or by
# OracleDeployment/fetch_secrets_from_vault.sh. Never commit it.
.env

# Python bytecode from the DummyData helper scripts.
__pycache__/
*.pyc
