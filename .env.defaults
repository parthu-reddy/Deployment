# Non-secret deployment settings. TRACKED IN GIT deliberately — none of these is a credential.
#
# fetch_secrets_from_vault.sh writes .env as: these defaults, then the secrets pulled from OCI
# Vault. Keeping them here means a regenerated .env is COMPLETE. The first version of that script
# emitted only the six vault secrets plus three hardcoded extras, silently dropping seven keys and
# overwriting ALLOWED_ORIGINS — which breaks CORS and leaves POSTGRES_USER empty.
#
# Rule: if a value is not a credential, it belongs here, not in the vault and not only in .env.

# --- Identities (not secrets; the passwords are in the vault) ---
POSTGRES_USER=postgres
CONFIG_USER=admin
EUREKA_USER=admin

# --- Cloudflare R2 non-secret coordinates ---
R2_ENDPOINT=https://80708a753745ca23eabc20b4b3dee5fa.r2.cloudflarestorage.com
R2_BUCKET_NAME=labouffe
R2_PUBLIC_URL=https://pub-331840c6b8de469a8750b945b9159673.r2.dev

# --- Platform ---
SPRING_PROFILES_ACTIVE=dev
PLATFORM_BUSINESS_ZONE=Asia/Kolkata
PLATFORM_DEFAULT_CURRENCY=INR

# 03_deploy_dev.sh appends the detected public IP to this list at deploy time.
# The live CORS allow-list, moved here from docker-compose.yml on 2026-08-28. It had been
# hardcoded inline on the api-gateway service, so no service read ${ALLOWED_ORIGINS} and this
# key was dead config: it looked authoritative and controlled nothing.
#
# This is the value that was actually in effect, copied verbatim. The previous value here
# (localhost:8080 plus two IPv6 literals) was never live, so it is dropped rather than merged:
# merging would widen CORS to origins the gateway has never accepted.
#
# The trycloudflare.com entry is a quick-tunnel URL. Those are ephemeral and change on every
# restart, so it is probably already stale; kept verbatim rather than silently removed.
ALLOWED_ORIGINS=http://140.245.234.137,http://140.245.234.137:3000,http://localhost:3000,http://localhost,https://gulf-strike-dark-extras.trycloudflare.com
