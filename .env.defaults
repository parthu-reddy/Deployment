# Non-secret deployment settings. TRACKED IN GIT deliberately — none of these is a credential.
#
# fetch_secrets_from_vault.sh writes .env as: these defaults, then the secrets pulled from OCI
# Vault. Keeping them here means a regenerated .env is COMPLETE. The first version of that script
# emitted only the six vault secrets plus three hardcoded extras, silently dropping seven keys and
# overwriting ALLOWED_ORIGINS — which breaks CORS and leaves POSTGRES_USER empty.
#
# Rule: if a value is not a credential, it belongs here, not in the vault and not only in .env.

# --- Identities (not secrets; the passwords are in the vault) ---
POSTGRES_USER=postgres
CONFIG_USER=admin
EUREKA_USER=admin

# --- Cloudflare R2 non-secret coordinates ---
R2_ENDPOINT=https://80708a753745ca23eabc20b4b3dee5fa.r2.cloudflarestorage.com
R2_BUCKET_NAME=labouffe
R2_PUBLIC_URL=https://pub-331840c6b8de469a8750b945b9159673.r2.dev

# --- Platform ---
SPRING_PROFILES_ACTIVE=dev
# Dev-only seeded-account Autofill Code support. IdentityService additionally requires its
# non-production dev profile; an absent value is false at the Compose boundary.
DEV_OTP_ENABLED=true
# Parked by default. The E2E OTP inspection harness needs this explicit opt-in in addition to the
# e2e Spring profile and its separate runner secret. See E2E-OTP-HARNESS.md.
E2E_OTP_ENABLED=false
# The zone the ledger's books close in (reconciliation day, nightly run). Read by ledger-service only.
# Outlets and advertisers carry their own zones. TimezoneCorrectness_2026-09-25.
PLATFORM_ACCOUNTING_ZONE=Asia/Kolkata
PLATFORM_DEFAULT_CURRENCY=INR
# Comma-separated canonical IDs consumed by Config Service. Add a city here before its data is
# enabled; the Fleet Map selects only values returned by the authenticated Delivery endpoint.
FLEET_ALLOWED_CITY_IDS=BLR

# Browser CORS is pinned to one exact Dev tunnel origin. The Origin header never includes a
# trailing slash. Do not add localhost, raw IPs, or a wildcard here: change this one value through
# the documented Oracle refresh/recreate procedure when the intentionally selected tunnel changes.
ALLOWED_ORIGINS=https://gulf-strike-dark-extras.trycloudflare.com

# Container registry holding every service image. Config, not a secret: it is a hostname and a
# tenancy namespace, both visible in any image reference. Needed by docker-compose.yml for all 20
# services, so a bare `docker compose ps` on the VM warns without it.
REGISTRY=hyd.ocir.io/axekmbadoczl

BIOMETRIC_VERIFICATION_ENABLED=false
TIMEZONE=Etc/UTC
