# Copy to .env on the deployment host and fill in, or generate it with
#   OCI_VAULT_ID=ocid1.vault... ./OracleDeployment/fetch_secrets_from_vault.sh
#
# .env is gitignored and must stay that way: it was tracked and pushed from 2026-07-05 to
# 2026-08-28, so every value committed in that window must be treated as compromised and rotated.

# --- Database ---
POSTGRES_USER=
POSTGRES_PASS=

# --- Spring Cloud Config Server (basic auth) ---
CONFIG_USER=
CONFIG_PASSWORD=

# --- Eureka (basic auth) ---
EUREKA_USER=
EUREKA_PASSWORD=

# --- Cloudflare R2 object storage ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Ola Maps ---
OLA_MAPS_API_KEY=

# --- Non-secret platform settings ---
SPRING_PROFILES_ACTIVE=dev
# Dev-only seeded-account Autofill Code support. IdentityService additionally requires its
# non-production dev profile; an absent value is false at the Compose boundary.
DEV_OTP_ENABLED=true
# Parked by default. The E2E OTP inspection harness needs this explicit opt-in in addition to the
# e2e Spring profile and its separate runner secret. See E2E-OTP-HARNESS.md.
E2E_OTP_ENABLED=false
# The zone the ledger's books close in (reconciliation day, nightly run). Read by ledger-service only.
# Outlets and advertisers carry their own zones. TimezoneCorrectness_2026-09-25.
PLATFORM_ACCOUNTING_ZONE=Asia/Kolkata
PLATFORM_DEFAULT_CURRENCY=INR
FLEET_ALLOWED_CITY_IDS=BLR
# Exact Dev browser origin. Use one canonical https origin with no trailing slash; see
# Deployment/README.md before changing a quick-tunnel hostname.
ALLOWED_ORIGINS=https://gulf-strike-dark-extras.trycloudflare.com

# --- Added 2026-08-30 while closing Phase 3 -------------------------------------------------
# CONFIG (not secret) -- safe to keep in git, safe to edit here.
REGISTRY=hyd.ocir.io/<tenancy-namespace>
# SECRETS -- placeholders only. Real values are materialised on the VM by
# OracleDeployment/fetch_secrets_from_vault.sh. IDENTITY_HMAC_SECRET is required consistently by
# the gateway and every verifying service. E2E_RUNNER_SECRET is deliberately absent here: the
# E2E-only Vault fetch writes it to .env.e2e, which only docker-compose.e2e.yml consumes.
IDENTITY_HMAC_SECRET=<from-vault>
AUCTION_TOKEN_SECRET=<from-vault>
