# Copy to .env on the deployment host and fill in, or generate it with
#   OCI_VAULT_ID=ocid1.vault... ./OracleDeployment/fetch_secrets_from_vault.sh
#
# .env is gitignored and must stay that way: it was tracked and pushed from 2026-07-05 to
# 2026-08-28, so every value committed in that window must be treated as compromised and rotated.

# --- Database ---
POSTGRES_USER=
POSTGRES_PASS=

# --- Spring Cloud Config Server (basic auth) ---
CONFIG_USER=
CONFIG_PASSWORD=

# --- Eureka (basic auth) ---
EUREKA_USER=
EUREKA_PASSWORD=

# --- Cloudflare R2 object storage ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=

# --- Ola Maps ---
OLA_MAPS_API_KEY=

# --- Non-secret platform settings ---
SPRING_PROFILES_ACTIVE=dev
# The zone the ledger's books close in (reconciliation day, nightly run). Read by ledger-service only.
# Outlets and advertisers carry their own zones. TimezoneCorrectness_2026-09-25.
PLATFORM_ACCOUNTING_ZONE=Asia/Kolkata
PLATFORM_DEFAULT_CURRENCY=INR
ALLOWED_ORIGINS=http://localhost

# NOT YET IN USE -- see RandomDocuments/RemainingWork_2026-08-27/FOLLOW_UPS.md item 1.
# security.identity.hmac-secret is currently unset everywhere, so all 13 processes fall back to a
# publicly known development key. Setting it requires passing SECURITY_IDENTITY_HMAC_SECRET to the
# gateway AND all 12 verifying services in the same deploy: a partial rollout means the gateway
# signs with one key while some services verify with another, and those services 403 everything.
# IDENTITY_HMAC_SECRET=

# --- Added 2026-08-30 while closing Phase 3 -------------------------------------------------
# CONFIG (not secret) -- safe to keep in git, safe to edit here.
REGISTRY=hyd.ocir.io/<tenancy-namespace>
# Dev-only. Quick tunnels get a new hostname per restart, so an exact origin cannot be pinned.
# Must NOT reach production: anyone can obtain a hostname under a public tunnel domain.
ALLOWED_ORIGIN_PATTERNS=

# SECRETS -- placeholders only. Real values are materialised on the VM by
# OracleDeployment/fetch_secrets_from_vault.sh. Both are referenced by 19 services and
# config-service; when absent, compose resolves them to a blank string and identity signing
# and auction tokens run on empty keys.
IDENTITY_HMAC_SECRET=<from-vault>
AUCTION_TOKEN_SECRET=<from-vault>
